{
  // Workspace-wide editor behaviour lives here. The project toolchain (Python,
  // tests, debugging, tasks, extensions) lives in .vscode/. Keep each key in one
  // place only: never add "launch", "tasks" or "extensions" to this file.
  "folders": [
    {
      "name": "QuakeDock",
      "path": "."
    }
  ],
  "settings": {
    // Repository conventions: UTF-8, LF, final newline, no trailing whitespace.
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,

    // Search already honours .gitignore; these only reduce explorer noise and
    // keep the watcher off large generated trees (.venv holds Qt/PySide6).
    "files.exclude": {
      "**/__pycache__": true,
      "**/.ruff_cache": true
    },
    "files.watcherExclude": {
      "**/.venv/**": true,
      "**/.venv-build/**": true,
      "**/build/**": true,
      "**/dist/**": true
    }
  }
}
