{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QuakeDock",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "QuakeDock: smoke test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": ["--smoke-test"],
      "cwd": "${workspaceFolder}",
      "env": {
        "QT_QPA_PLATFORM": "offscreen"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Tests: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["-v", "${relativeFile}"],
      "cwd": "${workspaceFolder}",
      "env": {
        "QT_QPA_PLATFORM": "offscreen"
      },
      "console": "integratedTerminal"
    }
  ]
}
